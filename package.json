{
  "name": "wlin-cli",
  "version": "0.4.2",
  "description": "Quickly create common templates",
  "keywords": [
    "cli",
    "scaffold",
    "template",
    "wlin"
  ],
  "homepage": "https://github.com/imehc/wlin-cli",
  "bugs": "https://github.com/imehc/wlin-cli/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imehc/wlin-cli.git"
  },
  "license": "MIT",
  "author": "imehc",
  "type": "module",
  "bin": {
    "wlin-cli": "bin/run.js"
  },
  "files": [
    "bin/run.js",
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/cli.ts --target=node --outfile dist/cli.js --minify",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "posttest": "bun run typecheck && bun run lint && bun run format:check",
    "verify:tarball": "node scripts/verify-tarball.js",
    "prepack": "bun run build && node scripts/pack-json.js trim",
    "postpack": "node scripts/pack-json.js restore",
    "prepare": "husky",
    "pub": "bash version.sh",
    "commit": "git cz"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "commitizen": "^4.3.2",
    "conventional-changelog-cli": "^5.0.0",
    "cz-git": "^1.13.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-git"
    }
  }
}
