{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "wlin-cli create (source)",
      "runtimeExecutable": "bun",
      "program": "${workspaceFolder}/bin/dev.js",
      "args": ["create"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
